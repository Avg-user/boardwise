DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=boardwise
POSTGRES_USER=boardwise
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-3-1.7b
# DEV ONLY. Free models need "allow" (their providers may train on prompts).
# Must be "deny" (the default when unset) before any real user data goes through the app.
OPENROUTER_DATA_COLLECTION=allow
# Law-reference RAG. Empty = full-text search only (no embedding calls, works with a free key).
# Set e.g. openai/text-embedding-3-small (paid) to add vector search, then rerun `manage.py ingest_laws`.
EMBEDDING_MODEL=
# Voice dictation (the `speech` service in docker-compose.yml). Django signs one-time tickets
# with this secret and the speech service checks them; both read it from this file.
# Empty = dictation off (the mic button is hidden).
SPEECH_TICKET_SECRET=change-me
# Whisper model: tiny (fastest), base (default), small (more accurate, too slow live on CPU),
# medium, large-v3, turbo (need a GPU). tiny.en/base.en/small.en are English-only (no French).
SPEECH_MODEL=base
